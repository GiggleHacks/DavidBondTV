# Copy to `.env` and fill in. The server loads it via
# `node --env-file-if-exists=.env server.mjs` (see package.json "start").
# Without these, the app still runs: emails go to data/outbox/ and country
# flags are omitted — so signup/login work in development with no setup.

# --- Email delivery ----------------------------------------------------------
# Transport priority: Resend (if RESEND_API_KEY) → Gmail SMTP → dev outbox.
# Resend (recommended): better deliverability, no 500/day cap. Create a key at
# https://resend.com and verify your sending domain (add the SPF + DKIM DNS
# records it shows), then set MAIL_FROM to an address on that domain.
# RESEND_API_KEY=re_...
# MAIL_FROM=David Bond TV <noreply@davidbondtv.com>
#
# Gmail SMTP (fallback): requires 2-Step Verification, then an App Password from
# https://myaccount.google.com/apppasswords (16 chars, spaces removed).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
MAIL_FROM=DavidBond.TV <youraddress@gmail.com>

# --- Bot defense: Cloudflare Turnstile ---------------------------------------
# Free CAPTCHA on signup + password-reset. Create a widget at
# https://dash.cloudflare.com → Turnstile (sitekey is public; secret is server-
# side). When unset, signup falls back to the built-in math challenge.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET=0x4AAAAAAA...

# --- Social login (OAuth) ----------------------------------------------------
# Each provider is enabled only when BOTH its id + secret are set; otherwise its
# button is hidden and its routes 404. For every provider, set the redirect /
# callback URL to: BASE_URL/api/auth/oauth/<provider>/callback
#   Discord  → https://discord.com/developers/applications (no brand review)
#   Google   → https://console.cloud.google.com (OAuth consent screen + brand
#              verification, ~2-3 days, free)
#   GitHub   → https://github.com/settings/developers
# OAUTH_DISCORD_CLIENT_ID=...
# OAUTH_DISCORD_CLIENT_SECRET=...
# OAUTH_GOOGLE_CLIENT_ID=...
# OAUTH_GOOGLE_CLIENT_SECRET=...
# OAUTH_GITHUB_CLIENT_ID=...
# OAUTH_GITHUB_CLIENT_SECRET=...

# --- Links + sessions --------------------------------------------------------
BASE_URL=http://localhost:8080
AUTH_SECRET=generate-with-node-e-require-crypto-randomBytes-32-toString-hex

# --- Admin --------------------------------------------------------------------
# The primary admin ("David Bond") is created automatically on first boot — its
# generated password is printed once and saved to data/admin-credentials.txt.
# ADMIN_PASSWORD is now only an optional legacy fallback.
# ADMIN_PASSWORD=...        # optional fallback admin password
# ADMIN_SECRET=...          # keeps admin bearer tokens valid across restarts
# BYPASS_SECRET=...         # signs the geo-bypass cookie; keep stable across restarts

# --- Payments (Stripe membership) --------------------------------------------
# Without these, the site runs unchanged but checkout/portal return 503 and the
# only thing that unlocks premium is the admin role / an admin-granted comp.
# Test mode first (sk_test_… / a test webhook secret), then swap to live.
#   1. Create ONE Product with two recurring Prices (monthly + yearly), no trial.
#   2. Add a webhook endpoint → BASE_URL/api/pay/stripe/webhook, subscribed to:
#      checkout.session.completed, customer.subscription.updated,
#      customer.subscription.deleted, invoice.paid, invoice.payment_failed.
#   3. Enable + configure the Customer Portal in the Stripe dashboard.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...

# --- GIF picker in comments (Tenor) ------------------------------------------
# Free key from https://developers.google.com/tenor (Google Cloud → enable the
# Tenor API). When unset, the comment box simply hides the GIF button. Results
# are always served with Tenor's "high" content filter applied server-side.
# TENOR_API_KEY=AIza...

# --- Geo-restriction + Cloudflare --------------------------------------------
# Set to 1 ONLY when the origin actually sits behind Cloudflare, so the server
# trusts CF-Connecting-IP / CF-IPCountry. Off → country comes from a local
# MaxMind DB (if built) or an admin "simulate country" toggle.
TRUST_CLOUDFLARE=0

# --- Video pipeline ----------------------------------------------------------
LIVE_VARIANTS=360p,720p       # quality tiers the live uploader renders
ORIGINAL_RETENTION_MS=90000   # delay before deleting the source after processing
KEEP_ORIGINALS=0              # 1 = never auto-delete uploaded source files

# --- Analytics ---------------------------------------------------------------
ANALYTICS_RAW_DAYS=7          # how many days of raw event logs to keep

# --- Auto titles/descriptions ------------------------------------------------
# Titles come from (in order): a speech transcript (if the clip has speech), the
# uploaded filename (name files meaningfully, e.g. "Bangkok Market Walk.mp4"),
# then a visual-mood fallback. Speech transcription is optional/local via
# whisper.cpp. Either set these env vars, OR drop a binary into ./whisper/ and a
# *.bin model into ./whisper/models/ and it's auto-detected.
# WHISPER_BIN=./whisper/whisper-cli
# WHISPER_MODEL=./whisper/models/ggml-base.en.bin

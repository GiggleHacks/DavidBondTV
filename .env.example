# Copy to `.env` and fill in. The server loads it via
# `node --env-file-if-exists=.env server.mjs` (see package.json "start").
# Without these, the app still runs: emails go to data/outbox/ and country
# flags are omitted — so signup/login work in development with no setup.

# --- Email delivery ----------------------------------------------------------
# Transport priority: Resend (if RESEND_API_KEY) → Gmail SMTP → dev outbox.
# Resend (recommended): better deliverability, no 500/day cap. Create a key at
# https://resend.com and verify your sending domain (add the SPF + DKIM DNS
# records it shows), then set MAIL_FROM to an address on that domain.
# RESEND_API_KEY=re_...
# MAIL_FROM=David Bond TV <noreply@davidbondtv.com>
#
# Gmail SMTP (fallback): requires 2-Step Verification, then an App Password from
# https://myaccount.google.com/apppasswords (16 chars, spaces removed).
GMAIL_USER=youraddress@gmail.com
GMAIL_APP_PASSWORD=your16charapppassword
MAIL_FROM=DavidBond.TV <youraddress@gmail.com>

# --- Bot defense: Cloudflare Turnstile ---------------------------------------
# Free CAPTCHA on signup + password-reset. Create a widget at
# https://dash.cloudflare.com → Turnstile (sitekey is public; secret is server-
# side). When unset, signup falls back to the built-in math challenge.
# TURNSTILE_SITE_KEY=0x4AAAAAAA...
# TURNSTILE_SECRET=0x4AAAAAAA...

# --- Social login (OAuth) ----------------------------------------------------
# Each provider is enabled only when BOTH its id + secret are set; otherwise its
# button is hidden and its routes 404. For every provider, set the redirect /
# callback URL to: BASE_URL/api/auth/oauth/<provider>/callback
#   Discord  → https://discord.com/developers/applications (no brand review)
#   Google   → https://console.cloud.google.com (OAuth consent screen + brand
#              verification, ~2-3 days, free)
#   GitHub   → https://github.com/settings/developers
# OAUTH_DISCORD_CLIENT_ID=...
# OAUTH_DISCORD_CLIENT_SECRET=...
# OAUTH_GOOGLE_CLIENT_ID=...
# OAUTH_GOOGLE_CLIENT_SECRET=...
# OAUTH_GITHUB_CLIENT_ID=...
# OAUTH_GITHUB_CLIENT_SECRET=...

# --- Links + sessions --------------------------------------------------------
BASE_URL=http://localhost:8080
AUTH_SECRET=generate-with-node-e-require-crypto-randomBytes-32-toString-hex

# --- Admin --------------------------------------------------------------------
# The primary admin ("David Bond") is created automatically on first boot — its
# generated password is printed once and saved to data/admin-credentials.txt.
# ADMIN_PASSWORD is now only an optional legacy fallback.
# ADMIN_PASSWORD=...        # optional fallback admin password
# ADMIN_SECRET=...          # keeps admin bearer tokens valid across restarts
# BYPASS_SECRET=...         # signs the geo-bypass cookie; keep stable across restarts

# --- Payments (Stripe membership) --------------------------------------------
# Without these, the site runs unchanged but checkout/portal return 503 and the
# only thing that unlocks premium is the admin role / an admin-granted comp.
# Test mode first (sk_test_… / a test webhook secret), then swap to live.
#   1. Create ONE Product with two recurring Prices (monthly + yearly), no trial.
#   2. Add a webhook endpoint → BASE_URL/api/pay/stripe/webhook, subscribed to:
#      checkout.session.completed, customer.subscription.updated,
#      customer.subscription.deleted, invoice.paid, invoice.payment_failed.
#   3. Enable + configure the Customer Portal in the Stripe dashboard.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRICE_MONTHLY=price_...
# STRIPE_PRICE_YEARLY=price_...
# Maintenance kill-switch. Set to 1 to FREEZE new charges (membership checkout +
# product purchase): the buy buttons grey out as "Payments Under Maintenance" and
# the server refuses new sales (503). Existing members keep access and can still
# manage/cancel billing; webhooks + reconcile keep finalizing in-flight sales.
# PAYMENTS_FROZEN=1

# Hard-disable the Stripe card rail (account suspended). When '1', the Card option
# is hidden and Stripe checkout refuses — WHOP (below) becomes the card rail.
# STRIPE_DISABLED=1

# --- WHOP card payments (the card rail that replaces suspended Stripe) --------
# Server-to-server API key (Dashboard → Developer). Creating products/plans + the
# webhook are done in the WHOP dashboard. When unset, the Card option stays hidden.
# WHOP_API_KEY=apik_...
# Webhook signing secret (Dashboard → Developer → Webhooks). Standard-Webhooks
# scheme; the endpoint to register is https://<your-host>/api/pay/whop/webhook
# with events: payment.succeeded, membership.activated/went_valid,
# membership.deactivated/went_invalid, refund.created.
# WHOP_WEBHOOK_SECRET=whsec_...
# The membership plan id buyers check out (Dashboard → your product → plan).
# WHOP_PLAN_ID=plan_...
# Your WHOP company/business id (biz_...), used on checkout-session creation.
# WHOP_COMPANY_ID=biz_...
# Optional fallback price (USD dollars) for the Card headline if the live plan
# lookup is unavailable. The real charge is always whatever the WHOP plan is set to.
# WHOP_PRICE_USD=47

# --- Telegram sale alerts ----------------------------------------------------
# Emoji-rich sale notifications to a Telegram chat. Create a bot via @BotFather,
# then message the bot and visit https://api.telegram.org/bot<TOKEN>/getUpdates
# to find your chat_id. When unset, no alerts are sent (everything else works).
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...

# --- Private Telegram group access gate --------------------------------------
# Gate a PRIVATE Telegram group behind payment: paid users mint a one-time,
# single-use invite; the group link is never exposed publicly; lapsed members are
# auto-removed. Reuses TELEGRAM_BOT_TOKEN above. Requires the bot to be an ADMIN
# of the group (with "Invite Users via Link" + "Ban Users"). Ships dark unless
# all of GROUP_CHAT_ID + WEBHOOK_SECRET + BOT_USERNAME are set.
#   GROUP_CHAT_ID — the private group's chat id (e.g. -1001234567890). Find it by
#     temporarily adding @RawDataBot to the group and reading chat.id.
#   WEBHOOK_SECRET — random hex; the bot webhook is reached at
#     <BASE_URL>/api/telegram/webhook?token=<SECRET>. Register it once with:
#     curl "https://api.telegram.org/bot<TOKEN>/setWebhook?url=<BASE_URL>/api/telegram/webhook?token=<SECRET>&allowed_updates=[\"message\"]"
#   BOT_USERNAME — the bot's @username (no @), used to build t.me/<bot>?start= links.
# NOTE: setting a webhook disables getUpdates polling for this token — fine here,
# since the alerts notifier only sends.
# TELEGRAM_GROUP_CHAT_ID=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_BOT_USERNAME=
# TELEGRAM_LINK_TOKEN_TTL_MS=900000   # deep-link token lifetime (default 15 min)
# TELEGRAM_INVITE_TTL_MS=600000       # single-use invite lifetime (default 10 min)

# --- GIF picker in comments (Tenor) ------------------------------------------
# Free key from https://developers.google.com/tenor (Google Cloud → enable the
# Tenor API). When unset, the comment box simply hides the GIF button. Results
# are always served with Tenor's "high" content filter applied server-side.
# TENOR_API_KEY=AIza...

# --- Geo-restriction + Cloudflare --------------------------------------------
# Set to 1 ONLY when the origin actually sits behind Cloudflare, so the server
# trusts CF-Connecting-IP / CF-IPCountry. Off → country comes from a local
# MaxMind DB (if built) or an admin "simulate country" toggle.
TRUST_CLOUDFLARE=0

# --- Video pipeline ----------------------------------------------------------
LIVE_VARIANTS=360p,720p       # quality tiers the live uploader renders
ORIGINAL_RETENTION_MS=90000   # delay before deleting the source after processing
KEEP_ORIGINALS=0              # 1 = never auto-delete uploaded source files

# --- Analytics ---------------------------------------------------------------
ANALYTICS_RAW_DAYS=7          # how many days of raw event logs to keep

# --- Video sync (local → server publish) -------------------------------------
# Process videos on the LOCAL machine, then click "Publish to server" on the
# Videos admin page to push finished artifacts (renditions, thumbnails, previews,
# storyboards) + the manifest entry to production. The server does NO transcoding.
#
# SYNC_TOKEN must be set identically on BOTH machines (a long random secret).
# When unset on the server, the /api/sync/* receive endpoints return 404.
# SYNC_TARGET_URL is set on the LOCAL machine only — the production address to
# publish to. Leave it unset on the server.
# SYNC_TOKEN=<64-hex shared secret, same on both ends>
# SYNC_TARGET_URL=https://davidbondtv.com   # LOCAL machine only

# --- Auto titles/descriptions ------------------------------------------------
# Titles come from (in order): a speech transcript (if the clip has speech), the
# uploaded filename (name files meaningfully, e.g. "Bangkok Market Walk.mp4"),
# then a visual-mood fallback. Speech transcription is optional/local via
# whisper.cpp. Either set these env vars, OR drop a binary into ./whisper/ and a
# *.bin model into ./whisper/models/ and it's auto-detected.
# WHISPER_BIN=./whisper/whisper-cli
# WHISPER_MODEL=./whisper/models/ggml-base.en.bin


# --- Self-hosted crypto payments ---
# HMAC secret the cccbox watcher uses to sign payment-confirmed callbacks. Generate: openssl rand -hex 32
CRYPTO_WEBHOOK_SECRET=
# Base URL of the watcher service on cccbox (via Cloudflare Tunnel), e.g. https://crypto.davidbondtv.com
CRYPTO_WATCHER_URL=
# Bearer token the main app uses to call the watcher's /quote and /watch. Generate: openssl rand -hex 32
CRYPTO_WATCHER_TOKEN=
